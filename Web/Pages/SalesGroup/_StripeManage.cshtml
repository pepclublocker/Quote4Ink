@model Web.Data.Models.Client
<form hx-post="@Url.Page("/clients/index", "Update")" hx-target="#grid"
      hx-swap="innerHTML">

    <div class="modal fade" id="confirmationModal" tabindex="-1">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Model.FullName Data Sheet</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <!--Start modal body -->
                    <div class="row">
                        <div class="col-3">
                            <div class="main-card mb-3 card">
                                info
                            </div>
                        </div>
                        <div class="col-9">
                            <div class="main-card mb-3 card">
                                <div class="card-body">
                                    <h5 class="card-title">Client Info</h5>

                                    <div class="form-row">
                                        <input asp-for="@Model.FirstName" class="form-control" />
                                        <label class="form-label">First Name</label>
                                        <span asp-validation-for="@Model.FirstName" class="text-danger"></span>
                                    </div>
                                    <div class="form-row">
                                        <input asp-for="@Model.LastName" class="form-control " />
                                        <label class="form-label">Last Name</label>
                                        <span asp-validation-for="@Model.LastName" class="text-danger"></span>
                                    </div>

                                    <div class="form-row">
                                        <input asp-for="@Model.Address" class="form-control " />
                                        <label class="form-label">Address</label>
                                        <span asp-validation-for="@Model.Address" class="text-danger"></span>
                                    </div>

                                    <div class="form-row">
                                        <input asp-for="@Model.City" class="form-control " />
                                        <label class="form-label">City</label>
                                        <span asp-validation-for="@Model.City" class="text-danger"></span>
                                    </div>
                                    <div class="form-row">
                                        <input asp-for="@Model.State" class="form-control " />
                                        <label class="form-label">State</label>
                                        <span asp-validation-for="@Model.State" class="text-danger"></span>
                                    </div>
                                    <div class="form-row">
                                        <input asp-for="@Model.ZipCode" class="form-control " />
                                        <label class="form-label">Zip Code</label>
                                        <span asp-validation-for="@Model.ZipCode" class="text-danger"></span>
                                    </div>
                                    <div class="form-row">
                                        <input asp-for="@Model.Email" class="form-control" />
                                        <label class="form-label">Email</label>
                                        <span asp-validation-for="@Model.Email" class="text-danger"></span>
                                    </div>

                                    <div class="form-row">
                                        <input asp-for="@Model.Id" type="hidden" />
                                        <input asp-for="@Model.CompanyID" type="hidden" />
                                        <input asp-for="@Model.DateCreated" type="hidden" />
                                        <input asp-for="@Model.DateUpdated" type="hidden" />

                                    </div>
                                </div>
                            </div>
                        </div> <!---->
                    </div> <!--row-->
                </div> <!--End modal body -->


                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>

                    <!-- The confirmation action button -->
                    <button type="submit"
                            class="btn btn-danger"
                            data-bs-dismiss="modal">
                        Save
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>
<!-- JavaScript to show the modal (if using a framework like Bootstrap) -->
<script>
    var modal = new bootstrap.Modal(document.getElementById('confirmationModal'));
    modal.show();
</script>




