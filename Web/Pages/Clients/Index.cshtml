@page
@model Web.Pages.ClientsModel
@{
}

<style>
    .htmx-indicator {
        opacity: 0;
        transition: opacity 200ms ease-in; /* Optional: for a smooth fade-in */
    }

    /* Show the spinner when the htmx-request class is present */
    .htmx-request .htmx-indicator {
        opacity: 1;
    }

    #grid:disabled {
        display: none;
    }
    /* Style for all elements with the 'disabled' attribute, even non-form ones */
    [disabled] {
        pointer-events: none; /* Prevents mouse clicks */
        opacity: 0.5; /* Visually indicates a disabled state */
        cursor: not-allowed; /* Changes the cursor */
    }

        /* Also ensure keyboard navigation is handled by setting tabindex to -1 */
        [disabled]:focus {
            tabindex: -1; /* Prevents focus via keyboard tabbing */
        }

</style>
<div class="app-page-title" >
    <div class="page-title-wrapper">
        <div class="page-title-heading">
            <div class="page-title-icon">
                <i class="ti ti-user-scan"></i>
                   
            </div>
            <div>
                Customer Dashboard
                <div class="page-title-subheading">
                    Info about customers.
                </div>
            </div>
        </div>
        <div class="page-title-actions">
            <a asp-page="/Clients/ClientManage" asp-route-clientid="0" class="btn-shadow btn btn-info" id="submitButton">
                <span class="btn-icon-wrapper pr-2 opacity-7">
                    <i class="ti ti-circle-plus"></i>
                </span>
                <span>
                    Add Customer
                </span>

            </a>
           
        </div>
    </div>
</div>



<div class="row">
    <div class="col card ">
        <div class="card-header">
            <div class="card-header-title">

                Client List
            </div>
        </div>
        <div class="card-body mr-5 ml-5">
            <div id="grid">
                <partial name="_ClientList" model="Model.pClients" />
            </div>

            <img id="spinner" class="htmx-indicator" src="/path/to/your/spinner.svg" alt="Loading...">

        </div>
    </div>
</div>



<div id="modal-container"></div>



