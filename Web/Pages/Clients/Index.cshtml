@page
@model Web.Pages.ClientsModel
@{
}


<div class="app-page-title" >
    <div class="page-title-wrapper">
        <div class="page-title-heading">
            <div class="page-title-icon">
                <i class="ti ti-user-scan"></i>
                   
            </div>
            <div>
                Customer Dashboard
                <div class="page-title-subheading">
                    Info about customers.
                </div>
            </div>
        </div>
        <div class="page-title-actions">
            <a asp-page="/Clients/ClientManage" asp-route-clientid="0" class="btn-shadow btn btn-info" id="submitButton">
                <span class="btn-icon-wrapper pr-2 opacity-7">
                    <i class="ti ti-circle-plus"></i>
                </span>
                <span>
                    Add Customer
                </span>

            </a>
           
        </div>
    </div>
</div>



<div class="row">
    <div class="col card ">
        <div class="card-header">
            <div class="card-header-title">

                Client List
            </div>
        </div>
        <div class="card-body mr-5 ml-5">
            <div id="grid">
                <partial name="_ClientList" model="Model.pClients" />
            </div>
        </div>
    </div>
</div>

<ul hx-boost="true"
    hx-target="#grid"
    hx-swap="outerHTML swap:1s"
    hx-disbled-elt="find button"
   
    hx-trigger='confirmed'
    onClick="Swal.fire({title: 'Confirm', text:'Do you want to continue?'}).then((result)=>{
            if(result.isConfirmed){
              htmx.trigger(this, 'confirmed');
            }
        })"
    class="customer-list list-group list-group-lg list-group-flush list my--4" style="disabled-opacity:2">
    @foreach (var customer in Model.pClients)
    {
        <li class="list-group-item px-0">
            <div class="row align-items-center">
                <div class="col-auto">
                    <span class="avatar avatar-lg">
                        <div>@customer.CompanyID</div>
                    </span>
                </div>
                <div class="col ml--2">
                    <h4 class="card-title mb-1">
                      
                    </h4>
                    <p class="card-text small text-muted mb-1">
                        @customer.FirstName
                    </p>
                </div>
                <div class="col-auto">
                    <form asp-page-handler="Delete" asp-route-id="@customer.Id">
                        <button type="submit" class="btn btn-sm btn-danger d-none d-md-inline-block" >
                            Delete
                        </button>
                    </form>
                </div>
            </div>
        </li>
    }
</ul>


<!--Modals-->

<div class="modal fade" tabindex="-1" role="dialog" id="details-modal">

    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Are You Sure?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
               Are you sure you want to delete this customer?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="dataCancelDelete">Cancel</button>
                <button type="button" class="btn btn-danger" id="dataSubmitDelete">Delete Customer</button>
            </div>
        </div>
    </div>

</div>


