@page
@model Web.Pages.ClientsModel
@{
}


<div class="app-page-title">
    <div class="page-title-wrapper">
        <div class="page-title-heading">
            <div class="page-title-icon">
                <i class="ti ti-user-scan"></i>
                   
            </div>
            <div>
                Customer Dashboard
                <div class="page-title-subheading">
                    Info about customers.
                </div>
            </div>
        </div>
        <div class="page-title-actions">
            <a asp-page="/Clients/ClientManage" asp-route-clientid="0" class="btn-shadow btn btn-info">
                <span class="btn-icon-wrapper pr-2 opacity-7">
                    <i class="ti ti-circle-plus"></i>
                </span>
                <span>
                    Add Customer
                </span>

            </a>
           
        </div>
    </div>
</div>



<div class="row">
    <div class="col card ">
        <div class="card-header">
            <div class="card-header-title">

                Client List
            </div>
        </div>
        <div class="card-body mr-5 ml-5">
            <div id="grid">
               
            </div>
        </div>
    </div>
</div>



@section Scripts {
    <script src="~/js/pages.clients.index.js" asp-append-version="true"></script>

    <style>
        #clientList_wrapper {
            width: 100%
        }
    </style>

}
<!--Modals-->

<div class="modal fade" tabindex="-1" role="dialog" id="details-modal">

    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Are You Sure?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
               Are you sure you want to delete this customer?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="dataCancelDelete">Cancel</button>
                <button type="button" class="btn btn-danger" id="dataSubmitDelete">Delete Customer</button>
            </div>
        </div>
    </div>

</div>


