@model IEnumerable<Web.Data.Models.Client>

    <strong>DELETE WAS NOT SUCCESSFUL!</strong><br />




<table style="width:100%;white-space:nowrap" class="table table-hover table-secondary" id="clientList">
    <thead>
        <tr class="table-light">

            <th style="width:100%">Name</th>
            <th># Quotes</th>
            <th>Company</th>
            <th>Last Change</th>
            <th>Customer Since</th>
            <th></th>
        </tr>
    </thead>



    <tbody class="table-group-divider">
        @foreach (var _client in Model)
        {
            <tr>

                <td>@_client.FirstName @_client.LastName</td>

                <td>@_client.DateUpdated.Date.ToShortDateString()</td>
                <td>@_client.DateCreated.Date.ToShortDateString()</td>
                <td>


                    <a class="btn btn-primary btn-sm"
                       hx-get="@Url.Page("/clients/index", "ClientEdit")"
                       hx-vals='{"id":"@_client.Id"}'
                       hx-target="#modal-container"
                       hx-swap="innerHTML">
                        Edit
                    </a>

                    <a href="#" class="btn btn-danger btn-sm deleteComp"
                       hx-get="@Url.Page("/clients/index", "ConfirmDelete")"
                       hx-vals='{"id":"@_client.Id"}'
                       hx-target="#modal-container"
                       hx-swap="innerHTML"
                       disabled="@_client.Privledged">
                        Delete
                    </a>



                </td>
            </tr>
        }
    </tbody>


</table>
