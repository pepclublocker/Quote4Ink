@model IEnumerable<Web.Data.Models.Client>


<table style="width:100%;white-space:nowrap" class="table table-hover table-secondary" id="clientList">
    <thead>
        <tr class="table-light">
          
            <th style="width:100%">Name</th>
            <th># Quotes</th>
            <th>Company</th>
            <th>Last Change</th>
            <th>Customer Since</th>
            <th></th>
        </tr>
    </thead>

    <tbody class="table-group-divider">
        @foreach (var _client in Model)
        {
            <tr>
              
                <td>@_client.FirstName @_client.LastName</td>
             
                <td>@_client.DateUpdated.Date.ToShortDateString()</td>
                <td>@_client.DateCreated.Date.ToShortDateString()</td>
                <td>
                    @if (_client.Privledged != true)
                    {
                        <a class="btn btn-primary btn-sm" asp-page="/Clients/clientManage" asp-route-clientid="@_client.Id">
                            Edit
                        </a>

                        <button type="button" class="btn btn-danger btn-sm deleteComp" data-compid="@_client.Id">
                            Delete
                        </button>
                    }
                    else
                    {
                        <a class="btn btn-primary btn-sm" asp-page="/Clients/clientManage" asp-route-clientid="@_client.Id">
                            Edit
                        </a>
                    }


                </td>
            </tr>
        }
    </tbody>


</table>