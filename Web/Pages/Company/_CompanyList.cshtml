@model IEnumerable<Web.Data.Models.Company>

<div class="row project-cards">
    <div class="col-md-12 project-list">
        <div class="card">
            <div class="row">
                <div class="col-md-6">
                    <ul class="nav nav-tabs border-tab" id="top-tab" role="tablist">
                        <li class="nav-item"><span class="badge badge-primary" style="margin-right:5px">Last Name Filter:</span></li>
                        <li style="margin:1px;"><a href="javascript:filterSelection('all');" class="badge badge-primary nav-item">ALL</a></li>
                        @{
                            List<string> _intals = new List<string>();
                            foreach (var _company in Model.OrderBy(a => a.Name))
                            {
                                _intals.Add(_company.Name.Substring(0, 1).ToUpper());
                            }
                            _intals = _intals.Distinct().ToList();

                            foreach (var _intal in _intals)
                            {
                                <li style="margin:1px;"><a href="javascript:filterSelection('@_intal');" class="badge badge-primary nav-item">@_intal</a></li>
                            }
                        }
                    </ul>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-0 me-0"></div><a class="badge badge-primary float-end" href="projectcreate.html"> <i class="icofont icofont-ui-add"></i> Add New Company</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-12">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    @foreach (var _company in Model.OrderBy(a => a.Name))
                    {
                        <div class="col-xxl-4 col-lg-6 box-col-6" id="filter-@_company.Name.Substring(0, 1).ToUpper()">
                            <div class="project-box project-box2 b-light1-primary">
                                <a class="badge badgeedit badge-primary"
                                   hx-get="@Url.Page("/comapny/index", "ClientEdit")"
                                   hx-vals='{"id":"@_company.Id"}'
                                   hx-target="#modal-container"
                                   hx-indicator="#htmx-spinner"
                                   hx-swap="innerHTML">
                                    <i class="icofont icofont-edit-alt"></i>
                                    Edit
                                </a>

                                <h5 class="f-w-500">@_company.Name</h5>
                                <div class="d-flex">
                                    <i class="icofont icofont-company" style="font-size:25px; padding-right:5px;"></i>

                                    <div class="flex-grow-1">
                                        <h1 class="f-w-700 font-primary">xx</h1>
                                    </div>
                                </div>

                                <div class="row details">
                                    <div class="col-6"><span>Created Date </span></div>
                                    <div class="col-6 font-primary">@_company.DateCreated.Date.ToShortDateString() </div>
                                    <div class="col-6"> <span>Updated Date</span></div>
                                    <div class="col-6 font-primary">@_company.DateUpdated.Date.ToShortDateString()</div>
                                    <div class="col-6"> <span>Current Quotes</span></div>
                                    <div class="col-6 font-primary">XX</div>
                                    <div class="col-6"> <span>Total Quotes</span></div>
                                    <div class="col-6 font-primary">XX</div>

                                </div>


                                <a href="#" class="badge badge-danger badgedelete"
                                   hx-get="@Url.Page("/company/index", "ConfirmDelete")"
                                   hx-vals='{"id":"@_company.Id"}'
                                   hx-target="#modal-container"
                                   hx-swap="innerHTML"
                                 @*   disabled="@_company.Privledged" *@
                                >
                                    <i class="icofont icofont-ui-delete"></i>
                                    Delete
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
